# syntax=docker/dockerfile:1

FROM node:24-bookworm-slim AS build
ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION
ENV VITE_APP_VERSION=$APP_VERSION
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build && npm prune --omit=dev

FROM postgres:16-bookworm
ARG APP_VERSION=dev
ENV NODE_ENV=production
ENV APP_VERSION=$APP_VERSION
WORKDIR /app

# Install Node.js 24
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl ca-certificates \
  && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
  && apt-get install -y --no-install-recommends nodejs \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/server ./server
COPY --from=build /app/src/db ./src/db
COPY docker/all-in-one-entrypoint.sh /usr/local/bin/thoth-entrypoint.sh
RUN chmod +x /usr/local/bin/thoth-entrypoint.sh

ENV DATA_DIR=/var/opt/thoth
VOLUME ["/var/opt/thoth"]
EXPOSE 5232

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||5232)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/usr/local/bin/thoth-entrypoint.sh"]
