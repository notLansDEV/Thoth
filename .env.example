# Thoth environment configuration
#
# Copy this file and fill in your own values:
#   cp .env.example .env
#
# Never commit .env or .env.local — they are git-ignored and may contain secrets.
# .env.local overrides .env when present.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=development

# Port the Express API listens on (Vite proxies /api to this).
PORT=4000

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# REQUIRED in production. Must be at least 32 characters and unique per
# environment. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Option A (recommended): full connection string.
# Takes precedence over the DB_* values below when set.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/thoth

# Option B: discrete connection settings (used when DATABASE_URL is empty).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=thoth
DB_USER=postgres
DB_PASSWORD=postgres
